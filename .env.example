# Quorum Environment Configuration
# Copy this file to .env.local and adjust values as needed

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Set to 'true' to use in-memory mock services (no backend required)
# Set to 'false' to connect to live backend at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Live tally polling interval in milliseconds
VITE_SESSION_POLL_INTERVAL_MS=4000

# Optional: Enable debug logging
# VITE_DEBUG=true